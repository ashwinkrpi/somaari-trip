# AUTH_USER / AUTH_HASH: login for the web UI and API (required in production).
# Generate both lines with: npm run -s hash-password -- <user> >> .env
# AUTH_USER=
# AUTH_HASH=scrypt:16384:8:1:<salt>:<key>

# SEED_SAMPLE_DATA: true seeds sample logs on startup and enables POST /api/seed (dev only)
SEED_SAMPLE_DATA=false

# SOMAARI_TRIP_BIND: host IP the app binds to (default 127.0.0.1).
# 0.0.0.0 listens on every interface (LAN + ZeroTier/Tailscale), or use a single LAN/VPN IP.
# Other devices (and Overland) must be able to reach it.
SOMAARI_TRIP_BIND=127.0.0.1

# SOMAARI_TRIP_PORT: host port the app is published on (default 18473).
SOMAARI_TRIP_PORT=18473

# DATA_DIR: host directory with the daily trips_YYYY-MM-DD.csv files (default ./data).
# Mounted read-write (Overland ingest appends to it).
DATA_DIR=./data

# OVERLAND_TOKEN: shared secret for POST /api/overland (required).
# Generate with: openssl rand -hex 32. Set the same value as Overland's Access Token.
OVERLAND_TOKEN=

# INGEST_UID / INGEST_GID: host user that owns the CSV files in DATA_DIR (default 1001).
# The container runs as this user so appended files keep the same owner.
INGEST_UID=1001
INGEST_GID=1001

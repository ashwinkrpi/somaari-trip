# The login (user name and password) is not set here: it lives in auth.json in the data folder.
# The first start makes one and prints it once (docker logs somaari-trip). Change it with:
#   docker exec -it somaari-trip somaari-trip setpassword
# AUTH_USER / AUTH_HASH from older installs are moved into auth.json on the next start, and can
# then be removed from this file.

# NO_LOGIN: true runs with no login at all.
# Anyone who can reach SOMAARI_TRIP_BIND:SOMAARI_TRIP_PORT can then see your location history,
# so only use it with SOMAARI_TRIP_BIND=127.0.0.1 or on a network you fully trust.
# NO_LOGIN=false

# SEED_SAMPLE_DATA: true seeds sample logs on startup and enables POST /api/seed.
# Dev only, and not read from this file: run SEED_SAMPLE_DATA=true npm run dev. Docker ignores it.
SEED_SAMPLE_DATA=false

# SOMAARI_TRIP_BIND: host IP the app binds to (default 127.0.0.1).
# 0.0.0.0 listens on every interface (LAN + ZeroTier/Tailscale), or use a single LAN/VPN IP.
# Other devices (and Overland) must be able to reach it.
SOMAARI_TRIP_BIND=127.0.0.1

# SOMAARI_TRIP_PORT: host port the app is published on (default 18473).
SOMAARI_TRIP_PORT=18473

# DATA_DIR: host directory with the daily trips_YYYY-MM-DD.csv files (default ./data).
# Mounted read-write (Overland ingest appends to it). Only set it to keep them somewhere else.
# DATA_DIR=./data

# OVERLAND_TOKEN: shared secret for POST /api/overland (required).
# Generate with: openssl rand -hex 32. Set the same value as Overland's Access Token.
OVERLAND_TOKEN=

# INGEST_UID / INGEST_GID: host user that owns the data directory and CSV files (default 1001).
# The container runs as this user so appended files keep the same owner.
INGEST_UID=1001
INGEST_GID=1001
